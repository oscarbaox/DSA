{
  // --- Formatter Settings (clang-format) ---
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "ms-vscode.cpptools",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  // If clang-format is in a non-standard path, specify it here:
  // "C_Cpp.clang_format_path": "/usr/bin/clang-format",

  // --- Linter Settings (clang-tidy) ---
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.codeAnalysis.clangTidy.runWhen": "onSave", // or "onType"
  
  // Point clang-tidy to the compile_commands.json generated by CMake:
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}